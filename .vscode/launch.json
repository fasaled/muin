{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Muin extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode",
        "${workspaceFolder}/fixtures/pdf"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.js"],
      "preLaunchTask": "muin: build vscode extension"
    }
  ]
}
