{
  "name": "@fasaled/muin",
  "version": "0.0.0",
  "description": "A command-line tool (TUI + REPL) that represents the internal structure of a PDF file — indirect objects, streams, page tree, cross-references — as a navigable graph.",
  "license": "MIT",
  "type": "module",
  "author": "Francisco Sánchez <fa.sl@live.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fasaled/muin.git"
  },
  "homepage": "https://github.com/fasaled/muin",
  "bugs": {
    "url": "https://github.com/fasaled/muin/issues"
  },
  "keywords": [
    "pdf",
    "tui",
    "repl",
    "mcp"
  ],
  "bin": {
    "muin": "dist/cli.js"
  },
  "files": [
    "dist",
    "vendor/qpdf",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --outfile dist/cli.js --target node --format esm --banner '#!/usr/bin/env node'",
    "start": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "react-devtools-core": "^8.0.0",
    "zod": "^4.6.5"
  }
}
