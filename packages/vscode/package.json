{
  "name": "muin",
  "displayName": "Muin",
  "description": "Explore a PDF’s internals in the editor — objects, streams, page tree, and cross-references — as a navigable graph. Visual panel plus MCP tools for Copilot.",
  "version": "0.1.0",
  "publisher": "fasaled",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fasaled/muin.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "muin.explorePdf",
        "title": "Explore PDF",
        "category": "Muin",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "muin.explorePdf",
          "when": "resourceExtname == .pdf",
          "group": "navigation@10"
        }
      ],
      "editor/title": [
        {
          "command": "muin.explorePdf",
          "when": "resourceExtname == .pdf",
          "group": "navigation"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "muin.mcp",
        "label": "Muin PDF"
      }
    ]
  },
  "scripts": {
    "build": "bun build src/extension.ts --outfile dist/extension.js --target node --format cjs --external vscode && bun build src/mcp-stdio.ts --outfile dist/mcp-stdio.js --target node --format esm && bun build ../core/src/worker/session-worker.ts --outfile dist/session-worker.js --target node --format esm && mkdir -p vendor && cp -R ../../vendor/qpdf vendor/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@muin/core": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/vscode": "^1.101.0"
  }
}
